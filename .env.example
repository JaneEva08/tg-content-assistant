# Скопируйте в .env и заполните. .env в git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID тех, кому бот отвечает (через запятую). Свой ID — у @userinfobot
ALLOWED_USER_IDS=

# Ключ и адрес OpenAI-совместимого API. Адрес — с /v1.
# OpenAI: https://api.openai.com/v1 · ProxyAPI: https://api.proxyapi.ru/openai/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://aiprimetech.io/v1
# Имя параметра лимита: max_completion_tokens (новые модели) или max_tokens
OPENAI_TOKENS_PARAM=max_tokens

# Модели для /model в боте (первая — по умолчанию)
AI_MODELS=gpt-6-astra,gpt-6-luna
# AI_MODEL=gpt-6-astra

# Параметры по умолчанию
AI_MAX_TOKENS=1000
# low | medium | high — пусто: по умолчанию модели
AI_EFFORT=
AI_TIMEOUT=60

# Сколько последних сообщений диалога помнить
CONTEXT_MAX_MESSAGES=20

# Профиль канала: по умолчанию channel.yaml, если его нет — channel.example.yaml
# CHANNEL_FILE=channel.yaml

LOG_LEVEL=INFO
